{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numisgraph-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*"]
  },
  "vars": {
    "APP_MODE": "local",
    "APP_ORIGIN": "http://127.0.0.1:8787",
    "VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "MARKET_DOMAINS": "",
    "AI_PER_USER": "400",
    "AI_GLOBAL": "4000"
  },
  "d1_databases": [{"binding": "DB", "database_name": "numisgraph-local", "database_id": "00000000-0000-0000-0000-000000000001"}],
  "kv_namespaces": [{"binding": "OAUTH_KV", "id": "00000000000000000000000000000001"}],
  "r2_buckets": [{"binding": "PHOTOS", "bucket_name": "numisgraph-local"}],
  "queues": {
    "producers": [{"binding": "IDENTIFY", "queue": "numis-identify-local"}],
    "consumers": [
      {"queue": "numis-identify-local", "max_batch_size": 10, "max_retries": 4, "dead_letter_queue": "numis-dead-local"},
      {"queue": "numis-dead-local", "max_batch_size": 10, "max_retries": 4}
    ]
  },
  "workflows": [{"binding": "PHOTO_WORKFLOW", "name": "numis-photo-local", "class_name": "PhotoWorkflow"}],
  "triggers": {"crons": ["17 * * * *"]},
  "observability": {"enabled": true}
}
